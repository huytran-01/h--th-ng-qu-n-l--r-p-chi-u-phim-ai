# ==============================================================================
# HỆ THỐNG QUẢN LÝ RẠP CHIẾU PHIM — CẤU HÌNH MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# ==============================================================================

# Cổng khởi chạy Express Backend (mặc định: 5000)
PORT=5000

# ==============================================================================
# CẤU HÌNH GOOGLE GEMINI API
# ==============================================================================
# 1. Truy cập https://aistudio.google.com/app/apikey (hoàn toàn MIỄN PHÍ)
# 2. Đăng nhập bằng tài khoản Google bất kỳ và bấm "Create API key"
# 3. Dán key nhận được vào biến GEMINI_API_KEY dưới đây
# Lưu ý: Nếu để trống hoặc key không hợp lệ, hệ thống sẽ tự động chuyển sang chế độ
#        Rule-based NLU (Offline fallback) đảm bảo đồ án chạy 100% mượt mà không bị lỗi.
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini muốn sử dụng (Mặc định khuyến nghị: gemini-2.5-flash hoặc gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
