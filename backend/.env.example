# Cổng dịch vụ Express Backend
PORT=5000

# Cấu hình Cơ sở dữ liệu MySQL Server 8.0+
USE_MYSQL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cinema_db

# Khóa Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
